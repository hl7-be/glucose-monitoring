  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet be-vs-diabetes-observation-code</b></p><a name=\"be-vs-diabetes-observation-code\"> </a><a name=\"hcbe-vs-diabetes-observation-code\"> </a><ul><li>Include these codes as defined in <a href=\"http://www.snomed.org/\"><code>http://snomed.info/sct</code></a><span title=\"Version is explicitly stated to be http://snomed.info/sct/11000172109\"> version ?http://snomed.info/sct/11000172109</span><table class=\"none\"><tr><td style=\"white-space:nowrap\"><b>Code</b></td><td><b>Display</b></td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141191000172105\">141191000172105</a></td><td style=\"color: #cccccc\">Percentage of time above level 1 hyperglycaemic threshold to total continuous glucose monitoring time using minimally-invasive continuous glucose monitoring device</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141201000172108\">141201000172108</a></td><td style=\"color: #cccccc\">Percentage of time above level 2 hyperglycaemic threshold to total continuous glucose monitoring time using minimally-invasive continuous glucose monitoring device</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141231000172103\">141231000172103</a></td><td style=\"color: #cccccc\">temps pendant lequel la valeur glycémique est dans l'intervalle 'normal' de la catégorie diabétique</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141211000172106\">141211000172106</a></td><td style=\"color: #cccccc\">temps pendant lequel la valeur glycémique est dans l'intervalle 'bas' de la catégorie diabétique</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141221000172101\">141221000172101</a></td><td style=\"color: #cccccc\">tijd waarin de glycemische waarde binnen het interval 'zeer laag' van de categorie ligt</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141151000172102\">141151000172102</a></td><td style=\"color: #cccccc\">gemiddeld aantal scans per dag</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141171000172109\">141171000172109</a></td><td style=\"color: #cccccc\">aantal ernstige hypoglycemische voorvallen</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141141000172104\">141141000172104</a></td><td style=\"color: #cccccc\">Frequency of hyperglycaemic episodes</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/365845005\">365845005</a></td><td style=\"color: #cccccc\">Hemoglobin A1C - diabetic control finding</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141161000172100\">141161000172100</a></td><td style=\"color: #cccccc\">Mean substance concentration of glucose in capillary blood using minimally-invasive continuous glucose monitoring device</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141121000172108\">141121000172108</a></td><td style=\"color: #cccccc\">coefficient de variation</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141131000172106\">141131000172106</a></td><td style=\"color: #cccccc\">nombre de jours de port du capteur</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141181000172107\">141181000172107</a></td><td style=\"color: #cccccc\">percentage opgenom</td></tr><tr><td><a href=\"http://snomed.info/sct/11000172109/id/141241000172105\">141241000172105</a></td><td style=\"color: #cccccc\">paramètre calculé sur la base du taux de glucose moyen</td></tr></table></li></ul></div>"
